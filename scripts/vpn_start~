#!/bin/sh
# A script to start ProtonVPN via OpenVPN on Slackware
# Assumes full installation of Slackware-current

# Can change VPN_CONFIG if you want to use a different VPN
VPN_CONFIG="/etc/openvpn/proton/ca-free-4.protonvpn.udp.ovpn"

# Re-invoke ourselves as root via su if not already root
if [ "$(id -u)" -ne 0 ]; then
    exec su -c "$0"
fi

echo "Disabling IPv6..."
sysctl -w net.ipv6.conf.all.disable_ipv6=1
sysctl -w net.ipv6.conf.default.disable_ipv6=1

cleanup() {
    echo "Re-enabling IPv6..."
    sysctl -w net.ipv6.conf.all.disable_ipv6=0
    sysctl -w net.ipv6.conf.default.disable_ipv6=0
}

trap cleanup EXIT

echo "Starting ProtonVPN..."
openvpn --config "$VPN_CONFIG"
